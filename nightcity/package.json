{
  "name": "homelab-stadt",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Night City Homelab – die Homelab-Topologie als 2.5D-Cyberpunk-Stadt",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/single.mjs",
    "preview": "vite preview --port 4173 --strictPort --host 127.0.0.1",
    "test:render": "node tests/render.mjs",
    "test:e2e": "node tests/interact.mjs",
    "test:perf": "node tests/perf.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "puppeteer-core": "^25.11.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
